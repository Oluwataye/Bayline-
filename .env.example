# App Configuration
NEXT_PUBLIC_APP_NAME="Warehouse Dashboard"
NEXT_PUBLIC_APP_SHORT_NAME="WMS"
NEXT_PUBLIC_DEFAULT_CURRENCY="NGN"
NEXT_PUBLIC_DEFAULT_LOCALE="en-NG"

# Supabase Production Credentials (configure when connecting live project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Demo / Offline Fallback Mode (true = instant preview without remote backend)
NEXT_PUBLIC_USE_DEMO_SEED=true

